    print("Retard hydraulique tau_h     : {:.0f} s  (permeabilite {:.0e} m2)"
          .format(temps_hydraulique(), PERMEABILITE))
    print("Puissance residuelle         : {:.1f} % de l'energie de fission, "
          "liberee avec retard".format(100 * GAMMA_DEC))

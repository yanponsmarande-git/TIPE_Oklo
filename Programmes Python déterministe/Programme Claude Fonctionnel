          .format(a_v))
    print("Criticite exacte atteinte a  : {:.1f} K = {:.1f} degC "
          "({:.1f} K sous l'ebullition)".format(T_c, T_c - 273.15, T_SAT - T_c))
    print("Capacite thermique du coeur  : {:.2e} J/K".format(capacite_coeur(600.0)))
    print("1 kg de vapeur chasse {:.2f} kg de liquide des pores"

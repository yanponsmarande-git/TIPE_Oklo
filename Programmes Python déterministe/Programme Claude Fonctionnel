def resume(res, marches, arrets, periodes):
    """Compare le regime obtenu aux observations d'Oklo."""
    frac, P_moy = bilan_energetique(res)
    n_der = max(1, len(marches) // 3)          # cycles etablis (dernier tiers)
    print("\n" + "=" * 74)
    print("  REGIME CYCLIQUE OBTENU        |     simulation    |     Oklo (RZ9)")
    print("-" * 74)
    if len(marches) >= 2:
        print("  duree de marche              |   {:6.1f} min     |     ~30 min"
              .format(marches[-n_der:].mean() / 60))
        print("  duree d'arret                |   {:6.1f} min     |     ~150 min"
              .format(arrets[-n_der:].mean() / 60))
        print("  periode                      |   {:6.1f} min     |     ~180 min"
              .format(periodes[-n_der:].mean() / 60))
        print("  rapport arret/marche         |   {:6.2f}         |      5.0"
              .format(arrets[-n_der:].mean() / marches[-n_der:].mean()))
        print("  dispersion sur les 5 derniers|   {:6.2f} min (marche)"
              .format(marches[-5:].std() / 60))
    else:
        print("  AUCUN CYCLE : le reacteur est eteint ou en regime permanent.")
    print("-" * 74)
    print("  puissance moyenne            |   {:6.1f} kW      |   6 a 100 kW"
          .format(P_moy / 1e3))
    print("  puissance de pointe          |   {:6.1f} kW".format(res['P'].max() / 1e3))
    # NB : 100 kW pour l'ensemble des 16 zones -> ~1e17 fissions/min au total,
    # soit ~1e16 pour RZ9 seule (et non 1e15 : erreur d'un facteur 10 a corriger
    # dans le compte rendu).
    print("  fissions par minute          |   {:.2e}    |     ~1e16"
          .format(P_moy * 60 / E_FISS_TOT))
    print("  part des fissions en marche  |   {:6.1f} %".format(100 * frac))
    print("  temperature du coeur         |   {:.1f} a {:.1f} K  (ebullition {:.1f} K)"
          .format(res['T'].min(), res['T'].max(), T_SAT))
    print("=" * 74)


def etude_sensibilite(duree=30 * 3600.0):
    """Balaye les quatre parametres geologiques inconnus et mesure le cycle.

    C'est la reponse a la question "le resultat est-il un reglage ?" : le cycle
    existe sur toute une plage de valeurs, seules ses durees se deplacent, et
    aucune duree n'est jamais fournie en entree.
    """
    global PERMEABILITE, K_MARGINAL
    perm0, k0 = PERMEABILITE, K_MARGINAL
    print("\n" + "=" * 74)
    print("  SENSIBILITE AUX PARAMETRES GEOLOGIQUES")
    print("=" * 74)
    print("  {:<34s} {:>10s} {:>10s} {:>10s}"
          .format("parametre", "marche", "arret", "P moyenne"))
    print("-" * 74)
    for nom, attribut, valeurs in (
            ("permeabilite k (m2)", 'PERMEABILITE',
             (1e-13, 6e-14, 3e-14, 1e-14)),
            ("k_eff a 615 K, pores pleins", 'K_MARGINAL',
             (0.999, 0.997, 0.995, 0.993))):
        for v in valeurs:
            globals()[attribut] = v
            try:
                calibrer_reflecteur(K_MARGINAL)
            except ValueError:
                print("  {:<34s} {:>10s}".format("%s = %.3g" % (nom, v),
                                                 "sous-critique"))
                continue
            res = simuler(duree=duree, verbose=False)
            ma, ar, _ = analyser_cycles(res)
            _, P_moy = bilan_energetique(res)
            if len(ma) < 2:
                print("  {:<34s} {:>32s}".format("%s = %.3g" % (nom, v),
                                                 "pas de cycle"))
            else:
                print("  {:<34s} {:>7.0f} min {:>6.0f} min {:>8.1f} kW"
                      .format("%s = %.3g" % (nom, v),
                              ma[-1] / 60, ar[-1] / 60, P_moy / 1e3))
        globals()[attribut] = {'PERMEABILITE': perm0, 'K_MARGINAL': k0}[attribut]
    PERMEABILITE, K_MARGINAL = perm0, k0
    calibrer_reflecteur(K_MARGINAL)
    print("=" * 74)


def tracer(res, marches, arrets):
    heures = res['t'] / 3600.0
    fig, ax = plt.subplots(3, 2, figsize=(13.5, 9))
    fig.suptitle("Reacteur naturel RZ9 d'Oklo : cycle limite auto-entretenu "
                 "(marche {:.0f} min / arret {:.0f} min)"
                 .format(marches[-1] / 60 if len(marches) else 0,
                         arrets[-1] / 60 if len(arrets) else 0))

    ax[0, 0].semilogy(heures, np.maximum(res['P'], 1e-6), lw=0.9)
    ax[0, 0].semilogy(heures, np.maximum(res['Q'], 1e-6), 'r--', lw=0.8,
                      label="evacue par conduction")
    ax[0, 0].set_ylabel('Puissance (W)')
    ax[0, 0].set_title("la puissance balaie plusieurs decades a chaque cycle",
                       fontsize=9)
    ax[0, 0].legend(fontsize=8)

    ax[0, 1].plot(heures, res['P'] / 1e3, lw=0.9)
    ax[0, 1].set_ylabel('Puissance (kW)')
    ax[0, 1].set_title("meme chose en echelle lineaire", fontsize=9)

    ax[1, 0].plot(heures, res['k'], lw=0.9)
    ax[1, 0].axhline(1.0, color='r', ls='--', lw=0.8)
    ax[1, 0].set_ylabel(r'$k_{eff}$')

    ax[1, 1].plot(heures, res['m_eau'], lw=0.9)
    ax[1, 1].set_ylabel("Eau dans les pores (kg)")
    ax[1, 1].set_title("le moderateur est chasse puis revient", fontsize=9)

    ax[2, 0].plot(heures, res['T'], lw=0.9, label='coeur')
    ax[2, 0].plot(heures, res['T_argile'], lw=0.9, label='argile a 5 cm')
    ax[2, 0].axhline(T_SAT, color='r', ls='--', lw=0.8, label='ebullition')
    ax[2, 0].set_ylabel('Temperature (K)')
    ax[2, 0].set_title("le cycle ne fait osciller le coeur que de ~1 K",
                       fontsize=9)
    ax[2, 0].legend(fontsize=8)

    # portrait de phase : la signature d'un cycle limite
    n0 = len(heures) // 3
    ax[2, 1].plot(res['m_eau'][n0:], np.log10(np.maximum(res['P'][n0:], 1e-6)),
                  lw=0.7)
    ax[2, 1].set_xlabel("Eau dans les pores (kg)")
    ax[2, 1].set_ylabel(r'$\log_{10}$ P (W)')
    ax[2, 1].set_title("portrait de phase (cycle limite)", fontsize=9)

    for a in ax.flat[:5]:
        a.set_xlabel('Temps (h)')
    for a in ax.flat:
        a.grid(alpha=0.3)
    fig.tight_layout()

    tracer_un_cycle(res, marches, arrets)
    plt.show()


def tracer_un_cycle(res, marches, arrets):
    """Zoom sur le dernier cycle etabli : c'est la figure a montrer au jury."""
    if len(marches) < 2:
        return
    P, Q, t = res['P'], res['Q'], res['t']
    fronts = np.diff((P > Q).astype(int))
    debuts = t[1:][fronts == 1]
    if len(debuts) < 3:
        return
    t0 = debuts[-2] - 0.25 * arrets[-1]
    t1 = debuts[-1] + 0.15 * arrets[-1]
    s = (t >= t0) & (t <= t1)
    minutes = (t[s] - debuts[-2]) / 60.0

    fig, ax = plt.subplots(3, 1, figsize=(9, 8), sharex=True)
    fig.suptitle("Un cycle : {:.0f} min de marche puis {:.0f} min d'arret"
                 .format(marches[-1] / 60, arrets[-1] / 60))
    ax[0].semilogy(minutes, np.maximum(P[s], 1e-3), lw=1.2)
    ax[0].semilogy(minutes, np.maximum(Q[s], 1e-3), 'r--', lw=0.9,
                   label='puissance evacuee')
    ax[0].fill_between(minutes, 1e-3, 1e7, where=P[s] > Q[s],
                       color='orange', alpha=0.18, label='marche')
    ax[0].set_ylim(1e0, 1e6)
    ax[0].set_ylabel('Puissance (W)')
    ax[0].legend(fontsize=8)

    ax[1].plot(minutes, res['k'][s], lw=1.2)
    ax[1].axhline(1.0, color='r', ls='--', lw=0.9)
    ax[1].set_ylabel(r'$k_{eff}$')

    ax[2].plot(minutes, res['m_eau'][s], lw=1.2)
    ax[2].set_ylabel("Eau dans les pores (kg)")
    ax[2].set_xlabel("Temps depuis le debut de la marche (min)")
    for a in ax:
        a.grid(alpha=0.3)
    fig.tight_layout()


def convergence_en_pas(duree=40 * 3600.0, pas=(20.0, 5.0, 1.25)):
    """Verifie que le resultat ne depend pas du pas de temps.

    C'est le controle numerique indispensable : une oscillation obtenue par un
    schema dissipatif ou mal converge n'a aucune valeur physique. On divise
    h_max par 4 deux fois de suite et on verifie que les durees du cycle ne
    bougent plus.
    """
    print("\n" + "=" * 74)
    print("  CONVERGENCE EN PAS DE TEMPS")
    print("=" * 74)
    print("  {:>8s} {:>9s} {:>10s} {:>10s} {:>12s}"
          .format("h_max (s)", "pas", "marche", "arret", "P moyenne"))
    print("-" * 74)
    for h in pas:
        res = simuler(duree=duree, h_max=h, verbose=False)
        ma, ar, _ = analyser_cycles(res)
        _, P_moy = bilan_energetique(res)
        if len(ma) < 2:
            print("  {:>8.2f}  pas de cycle".format(h))
            continue
        print("  {:>8.2f} {:>9d} {:>7.2f} min {:>6.2f} min {:>9.2f} kW"
              .format(h, len(res['t']), ma[-1] / 60, ar[-1] / 60, P_moy / 1e3))
    print("=" * 74)


def validation_cinetique(rho=1.0e-3, Lambda=3.0e-4):
    """Compare l'integrateur a la solution exacte de l'equation inhour.

    A reactivite constante, la population neutronique tend vers exp(t/T) ou T
    est la periode stable, racine de   rho = w.Lambda + somme(beta_i.w/(w+lam_i)).
    On verifie aussi qu'un seul grand pas donne le meme resultat que mille
    petits : c'est la signature d'une integration exacte.
    """
    global SOURCE_NEUTRONS
    source0 = SOURCE_NEUTRONS
    SOURCE_NEUTRONS = 0.0                      # on isole la cinetique
    lo, hi = 1e-8, 1e4
    for _ in range(200):                       # dichotomie sur l'equation inhour
        w = 0.5 * (lo + hi)
        if w * Lambda + np.sum(BETA_I * w / (w + LAMBDA_I)) < rho:
            lo = w
        else:
            hi = w
    periode_exacte = 1.0 / lo

    n, C = 1.0, BETA_I / (Lambda * LAMBDA_I)
    for _ in range(300):                       # on atteint le regime asymptotique
        n, C = pas_cinetique(n, C, rho, Lambda, 1.0)
    n1, C1 = n, C.copy()
    for _ in range(100):
        n, C = pas_cinetique(n, C, rho, Lambda, 1.0)
    periode_100pas = 100.0 / np.log(n / n1)
    n2, _ = pas_cinetique(n1, C1, rho, Lambda, 100.0)
    periode_1pas = 100.0 / np.log(n2 / n1)
    SOURCE_NEUTRONS = source0

    print("\n" + "=" * 74)
    print("  VALIDATION DE L'INTEGRATEUR DE CINETIQUE  (rho = {:.0e})".format(rho))
    print("-" * 74)
    print("  periode stable, equation inhour  : {:.4f} s".format(periode_exacte))
    print("  periode stable, 100 pas de 1 s   : {:.4f} s".format(periode_100pas))
    print("  periode stable, 1 pas de 100 s   : {:.4f} s".format(periode_1pas))
    print("  -> ecart relatif : {:.1e}"
          .format(abs(periode_100pas - periode_exacte) / periode_exacte))
    print("=" * 74)



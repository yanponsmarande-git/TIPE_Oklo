def section_efficace_fission_reelle(Tmod,eV): #modèlise l'effet de la température sur la section efficace de fission pour les neutrons thermiques en particulier.
    """Renvoie la section efficace de fission réelle en fonction de la température du modérateur en Kelvin et de l'energie des neutrons"""
    Tref = 293.6 # Kelvin
    if eV == 0:    #si les neutrons sont thermiques, alors on a l'approximation 1/sqrt(T)
         return(section_efficace_f_init[0]*np.sqrt(Tref/Tmod)*10**(-24))
    else :
        return(section_efficace_f_init[1]*10**(-24))

def criticite(Tcoeur, Tmod, frac_vap):
    """Renvoie le facteur multiplicatif effectif et le facteur antitrappe effectif du réacteur, en fonction des températures et de la fraction de neutrons rapides."""
    Tref = 293.6
    rho_eff = densite_effective(Tmod, frac_vap)
    alpha = coef_thermal(rho_eff)

    #epsilon le facteur de fission rapide.
    epsilon = 1.0001 #car absence de U238 et fissions rapides négligeables.
    #f facteur d'utilisation thermique.
    f = 0.66 # constante ajusté qui devrait être calculé d'après la composition du coeur (et corrigé par une absorption supplémentaire de 5% par la gangue).
    #etha le facteur de reproduction.
    sigma_th_abs,sigma_rapide_abs = section_efficace_abs[0]*10**(-24)*(293/Tmod)**(1/2), section_efficace_abs[1]*10**(-24)
    etha =  n_cree_moy * (alpha*section_efficace_fission_reelle(Tmod,0)+ (1-alpha)*section_efficace_fission_reelle(Tmod,1))/(sigma_th_abs*alpha + sigma_rapide_abs*(1-alpha))
    # p le facteur "antitrappe" de ralentissement (résonance U238)
    p_eff =  np.exp(-gamma*(Tmod**(1/2)-Tref**(1/2)))

    # P_NL les facteurs de non-fuites
    P_NL_th,P_NL_r = calcul_PNL(rho_eff)
    k_eff = etha * epsilon * f * p_eff * P_NL_th * P_NL_r
    return(tuple((k_eff, rho_eff)))

def formule_cinetique_minimal(Tcoeur, Tmod, k_eff, N0, rho_eff):
    """Renvoie le nombre de fissions, de neutrons produits
    selon la thermalisation,
    en fonction des températures et de caracteristiques efficace"""
    dt = 10**(-4)
    S_ext = fission_spontanee(atomes_U235)[0]*2.43  #neutrons par fission spontanée par générations
    G = dt/t_g_n    #temps caracteristiques sur une génération
    alpha = coef_thermal(rho_eff)
    #
    sigma_th,sigma_rapide = section_efficace_fission_reelle(Tmod,0),section_efficace_fission_reelle(Tmod,1)
    sigma_th_abs,sigma_rapide_abs = section_efficace_abs[0]*10**(-24)*(293/Tmod)**(1/2), section_efficace_abs[1]*10**(-24)
    poids_th = alpha * sigma_th
    poids_rapide  = (1-alpha) * sigma_rapide
    poids_tot = poids_th + poids_rapide
    sigma_f_eff = poids_th + poids_rapide
    sigma_abs_eff = sigma_th_abs*alpha + sigma_rapide_abs * (1-alpha)
    rapport = sigma_f_eff/sigma_abs_eff
    #
    N_produits = N0 + dt * (N0* (k_eff - 1) / t_g_n + S_ext)
    F_total = N0 * G * rapport
    #

    F_th = F_total * poids_th / poids_tot
    F_rapide  = F_total * poids_rapide  / poids_tot


    N_th_suivant = alpha* N_produits
    N_rap_suivant  = (1-alpha)* N_produits

    return(F_th,F_rapide, N_th_suivant, N_rap_suivant)


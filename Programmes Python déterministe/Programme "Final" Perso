def verif_vapeur(Tmod):
    """Renvoie vrai si l'eau est vaporisé, faux sinon, en fonction de sa température en Kelvin"""
    if Tmod >= T_ebullition:
        return True
    else: return False


def coef_thermal(rho_eau): #Possibilité de rendre continu et pas binaire
    """renvoie la fraction de thermalisation de n'import quel flux
    neutronique en fonction de la densité du modérateur, donc de l'état physique de l'eau, donc de sa température."""

    lambda_th  = 2.85*10**(-2) * (1000/rho_eau)
    return (1/(1+lambda_th/distance_moy))

def masse_vol_eau_liq(T):
    """Renvoie la densité de l'eau par interpolation des données du NIST Webook, en kg/m3 en fonction de la température """
    T_clippee = np.clip(T,T_NIST[0],T_NIST[-1])  #assure l'appartenance à l'intervalle de validité (273 K à 638 K)
    return(float(np.interp(T_clippee,T_NIST,RHO_NIST)))

def densite_effective(Tmoderateur, frac_vap):
    """Renvoie la densite moyenne/effective du mélange vapeur/liquide de l'eau en fonction de la température du modérateur et de la fraction de vapeur"""
    rho_liq = masse_vol_eau_liq(min(Tmoderateur,T_ebullition))
    rho_vap = rho_vap_eb
    return ((1 - frac_vap)*rho_liq + frac_vap*rho_vap)


def calcul_PNL(rho_eau):
    """Renvoie les facteur de non fuites thermique et rapide en fonction de la densité de l'eau"""
    tau = 27*10**(-4) * (1000/rho_eau)
    L = 2.85*10**(-2)*(1000/rho_eau)**(1/2)
    P_NL_r = np.exp(-B2* tau)
    P_NL_th = 1/(1+ B2 * L**2)
    return(P_NL_th,P_NL_r)


def temperature_coeur(nb,Tcoeur, Tmoderateur):
    """Renvoie la température dans le coeur en fonction du nombre de fissions
    pendant la génération, ainsi que les températures précédentes des différents
    milieux. Renvoie aussi l'energie thermique transmise au modérateur"""
    to = Tcoeur/1000
    h_vol = 200 # W.m-3.K-1
    surface = surface_coeur - 2*np.pi*2.1*0.7 #surface en contact seulement avec l'argile
    masse_argile = rho_argile * Vtot * 0.95 # car 95% du volume du coeur est de la roche plutot que le l'uraninite.
     #en W.m-1.K-1
    capacite_th_UO2 = 52.17 + 88*to - 84.2*to**2 +31.5*to**3 -2.6*to**4 -0.7*to**(-2) #en J.mol-1.K-1
    conduct_UO2 = 100/(7.5 + 17.7*to + 3.6*to**2) + (6400*np.exp(-16.35/to))/to**(5/2)
    gain = nb * 3.12*10**(-11) # 194.6 MeV absorbé par fission,en Joules.
    flux_thermique_vers_exterieur = (Tcoeur - Tmoderateur) * h_vol * Vtot
    perte = flux_thermique_vers_exterieur * 10**(-4) # en Joules

    temp_finale = (gain - perte)/(masse_argile*capacite_th_argile + atomes_U235*capacite_th_UO2/avogadro) + Tcoeur
    """print("T = ",temp_finale, "capacite_UO2 = ",capacite_th_UO2,"conduct_UO2 = ",conduct_UO2)"""
    return (temp_finale,perte)


def temperature_moderateur(e_recu, nb, Tmoderateur, frac_vap):
    """Renvoie la température du modérateur (argile/eau) et la fraction vaporisée en fonction en fonction de l'energie thermique provenant du coeur, du nombre de fissions, de son ancienne température et de la fraction vaporisée."""
    surface = surface_coeur - 2*np.pi*2.1*0.7 + 2*np.pi*2.1 #la surface qui sépare l'argile du grès.
    Vmod = (np.pi*2.1**2* 1.7 - Vtot)
    gain = e_recu + nb *3.4*10**(-12) # 21.5 MeV absorbé par fission en plus de l'energie transmise par le coeur, en Joules.

    """flux_thermique_vers_exterieur = (conduct_gres*surface)*(Tmoderateur - Tgres)/ 2.5 #en Joule par seconde
    perte = flux_thermique_vers_exterieur * 10**(-4) #en Joule"""

    flux_thermique_vers_exterieur = 500
    perte = flux_thermique_vers_exterieur * (Tmoderateur - Tgres) * Vtot

    rho_eau = densite_effective(Tmoderateur,frac_vap)
    volume_eau = Vmod*0.3 #en m3 pour une fraction volumique de 30%
    masse_eau = volume_eau * rho_eau
    cp_eau = 4215

    masse_argile = rho_argile * Vmod * 0.95 * 0.7 #même chose que pour le coeur sauf que la porosité de l'argile (où se situe l'eau) est prit en compte.
    capacithe_mod_tot = masse_argile*capacite_th_argile + masse_eau * cp_eau    # en J/K
    bilan = gain - perte
    #gestion du changement de phase de l'eau.
    #phase liquide :
    L_vap = 10**6   # chaleur latente à 150 bar et 342deg Celsius, en J/kg
    if Tmoderateur < T_ebullition and frac_vap == 0.0 :
        temp_finale = bilan/(capacithe_mod_tot) + Tmoderateur
        frac_vap_finale = 0.0
        #declanchement de la vaporisation :
        if temp_finale >= T_ebullition:
            Q_chauffage = capacithe_mod_tot *(T_ebullition -Tmoderateur)
            Q_restant = bilan - Q_chauffage
            frac_vap_finale = min(Q_restant/(masse_eau*L_vap),1.0)
            frac_vap_finale = max(frac_vap_finale,0.0)
            temperature_finale = T_ebullition
    #palier de vaporisation
    elif Tmoderateur >= T_ebullition or frac_vap > 0.0:
        temp_finale = T_ebullition
        if bilan > 0 :
            delta_frac = bilan/(masse_eau * L_vap)
            frac_vap_finale = min(frac_vap + delta_frac, 1.0)
        else :
            delta_frac = bilan/(masse_eau * L_vap)
            frac_vap_finale = max(frac_vap + delta_frac, 0.0)

        #vaporisation complete :
        if frac_vap_finale >= 1.0:
            frac_vap_finale = 1.0
        #condensation complete :
        if frac_vap_finale <= 0.0 :
            frac_vap_finale = 0.0
            # gestion de l'energie résiduelle :
            Q_residuel = bilan + frac_vap * masse_eau * L_vap
            temp_finale = T_ebullition + Q_residuel/capacithe_mod_tot
            #si refroidissement : Tmoderateur descend en dessous de T_ebullition :
            temp_finale = min(temp_finale, T_ebullition)

    return (temp_finale,frac_vap_finale)


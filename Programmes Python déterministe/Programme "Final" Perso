#Relatif aux calculs sur une génération, dans la section S du cylindre

def crit(n_1 : int,n_2 : int) -> int:
    """Renvoie la criticité du réacteur à un instant en fonction du nombre de neutrons générés entre deux générations"""

    return n_1/n_2


def fission_spontanee(n):
    """Renvoie le nombre de fissions spontanées ainsi que le nombre de noyaux restant après une génération, en fonction du nombre de noyaux actifs."""

    taux = (masse_mol_U5* taux_fission*1000)/avogadro   # fissions par seconde par atome d'U235
    nb_fissions = n*taux*10**(-4)

    return ( nb_fissions , n - nb_fissions)

